# Copy to .dev.vars for local `wrangler dev` (file is gitignored).
# For production, use `wrangler secret put` — see worker/README.md.

# Required — DeepSeek API key (sk-...)
DEEPSEEK_API_KEY=

# Optional — override API base (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional — CORS allowlist (comma-separated). Default * in wrangler.toml [vars].
# ALLOWED_ORIGINS=https://your-org.github.io,http://localhost:8080

# --- GitHub Actions only (repo Secrets, not wrangler) ---
# CLOUDFLARE_API_TOKEN=   # Workers deploy token from dash.cloudflare.com
# CLOUDFLARE_ACCOUNT_ID=  # Account ID from Workers dashboard
