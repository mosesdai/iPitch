{
  "name": "ipitch-server",
  "version": "0.1.0",
  "private": true,
  "description": "iPitch Phase 1–2 — R1 multi-step agent orchestrator + HTTP API",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "pipeline:dry": "node src/cli.js --dry-run",
    "pipeline:stub": "node src/cli.js --stub --target NIO",
    "pipeline:marathon:stub": "node src/cli.js --stub --profile marathon --target NIO",
    "serve": "node src/http.js"
  }
}
